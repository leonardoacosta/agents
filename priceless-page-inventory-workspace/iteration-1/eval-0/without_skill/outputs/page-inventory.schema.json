{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/next-page-inventory.schema.json",
  "title": "Next.js App Router Page Inventory",
  "type": "object",
  "required": ["schema_version", "generated_at", "app_directory", "pages"],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "app_directory": { "type": "string" },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["route", "source_files", "action", "view_access"],
        "properties": {
          "route": { "type": "string", "description": "URL path, with *name for catch-all parameters." },
          "source_files": { "type": "array", "items": { "type": "string" } },
          "action": { "type": "array", "description": "Manual test actions to perform on this page.", "items": { "type": "string" } },
          "view_access": { "type": "array", "description": "Roles, permissions, or access states to verify.", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
