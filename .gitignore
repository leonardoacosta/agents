__pycache__/
*.py[cod]
*.pyo
.DS_Store
.skill-lock.json.*.bak
skills/framer/projects/*/
!skills/framer/projects/__template__/
!skills/framer/projects/__template__/**

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Harness projection roots. Populated from skill-projections.json by
# scripts/reconcile-skill-projections.sh, so the entries are generated state.
# The recon links stay tracked on purpose: scripts/verify-recon-materialization.sh
# requires .claude/skills/recon, skills/recon, and agent/skills/recon to resolve
# to the same canonical directory.
/.agents/
/.claude/skills/*
!/.claude/skills/recon
