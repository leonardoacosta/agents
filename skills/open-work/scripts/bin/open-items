#!/usr/bin/env python3
"""open-items — all open work for the current project, one JSON object.

Sources (each degrades independently; a missing source is {"available": false}):
  beads         always unavailable (Beads tooling removed; the source key is
                kept so downstream consumers keep degrading gracefully)
  proposals     openspec-status --json  everything still under openspec/changes/
  plans         plans/ + advisor-plans/ README table rows whose Status is not
                DONE / REJECTED / SUPERSEDED / ARCHIVED
  plans_scratch unarchived top-level plans/ files (no README/ledger — pure
                plan-mode scratch pressure; see codify-plans-ledger-canon).
                {"unindexed": 0, "oldest_days": 0} when plans/ is absent.
  docs_plan     non-archived docs/plan/*/ dirs and loose .md files, each
                {name, promoted, bead} read from the .plan-ref/frontmatter
                contract /feature's Phase 4.5 write-back produces (see
                plan-ledger-closure-and-provenance). {"available": false}
                when docs/plan/ is absent.

Bucket classification (open-command-bucket-taxonomy, 2026-07-17): every
retained bead is classified into exactly ONE bucket so commands/open.md can
render it once, not in a flat table AND a second LLM-driven triage pass.
Precedence (first match wins): blocked > in_progress > hitl-disposition > human_only > open.
  blocked     has a "blocks"-type dependency edge (from the same JSONL
              export's own `dependencies` array — no live `bd dep list`
              call needed) pointing at an issue whose status is not closed.
  in_progress status == "in_progress" (and not blocked).
  hitl-disposition (open-hitl-disposition-and-blocker-notify, 2026-07-20): an
              `hitl:parked` / `hitl:answered` / `hitl:afk-converted` label
              (written by /open's step-6 disposition queue via `bd label
              add` — rules/BEADS.md § Bead Hygiene Standard taxonomy) wins
              over the human_only signals below. `hitl:parked` keeps the
              item in `human_only` but replaces `bucket_reason` with its
              standing state (`parked <MM-DD>: <reason>`, read from the most
              recent matching `HITL <verb>: <text>` comment already embedded
              in the JSONL export — no live `bd comments` call needed).
              `hitl:answered` / `hitl:afk-converted` flip the bucket to
              `open` — the human gate is resolved, so the item is
              agent-ready again with the answer/instruction sitting in the
              comment for whoever picks it up. This is what keeps a chat
              reclassification from silently reverting on the next /open
              pass (bd-example churn-audit exemplar: reclassified human-only in
              chat, no label ever written, re-bucketed agent-ready and
              re-asked the next day). `dispositioned: true` marks any item
              carrying one of these three labels, so commands/open.md's
              disposition queue can skip re-offering an already-answered
              item instead of re-deriving churn from a fresh classification
              every pass.
  human_only  HUMAN_ONLY_LABEL present in `labels` (explicit, wins over the
              heuristic), OR a "[user]" title prefix (existing tasks.md
              convention, reused here), OR the keyword heuristic
              (_HUMAN_ONLY_RE) matches the title. `bucket_reason` names
              which signal fired.
  open        default — agent-ready.
`ambiguous: true` marks a bare-fragment title (_looks_ambiguous) the
heuristic could plausibly be wrong about — commands/open.md resolves these
with a live `bd show` before finalizing rather than surfacing a separate
"check first" bucket. `cross_repo: <code>|null` flags a title mentioning
another project's registry code — rendered as an inline note on an
otherwise-open bead, not a separate bucket (feedback_ask_before_git_ops
still applies at dispatch time).

Arguments: --json (accepted; output is always JSON), --live-beads (query `bd`
instead of the committed export), --limit=N (item-table cap, default
ITEM_CAP; --limit=0 emits every retained bead — this is the "full list"
command references/rendering.md tells the renderer to name when `truncated`).

Counts vs items: `total_open`, `by_status`, `by_priority`, and `bucket_counts`
always describe EVERY retained bead; only `items` is capped. The compact-shape
headline in references/rendering.md mixes the two ("<total> remain unresolved:
<open> open, <in_progress> in progress, <blocked> blocked"), so a bucket tally
restricted to the visible page would render arithmetic that does not add up.

Contract (rules/TOOLING.md § Scripts-as-data-producers): --json on stdout,
exit 0 on ALL runtime failures (error key instead), no stderr chatter. Each
source is additionally isolated (see _guarded) so an unreadable file in one
scanner degrades that key alone instead of collapsing the whole document to a
bare {"error": ...}. Consumed by commands/open.md via a ```! preprocessor
block.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time

ITEM_CAP = 30
HUMAN_ONLY_LABEL = "human-only"
# open-hitl-disposition-and-blocker-notify: label -> (verb, target bucket).
# Order matters when a bead somehow carries more than one (re-disposition
# without the persistence step removing the prior label first) — the most
# decisive disposition (answered/afk-converted, both resolve the human gate)
# wins over a stale parked label.
HITL_LABELS = (
    ("hitl:answered", "answered", "open"),
    ("hitl:afk-converted", "afk-converted", "open"),
    ("hitl:parked", "parked", "human_only"),
)
# Matches the machine-parsed comment marker `/open`'s disposition batch
# writes via `bd comment <id> "HITL <verb>: <text>"` (commands/open.md § 7
# Human-only disposition batch). Anchored to the start of the comment text —
# a comment that merely mentions "HITL" mid-sentence never matches.
_HITL_COMMENT_RE = re.compile(r"^HITL (parked|answered|afk-converted):\s*(.*)$", re.DOTALL)

# Keyword-heuristic fallback for human_only when no explicit label is set.
# Ported from commands/open.md's former step-5 LLM triage table (2026-07-15
# -> 2026-07-17) so classification is deterministic and computed once instead
# of re-derived by an LLM pass on every /open invocation. Covers: physical
# hardware/device interaction, MFA/interactive-auth steps, access-portal
# enrollment, single-machine/SSH-yourself blockers, billing/org-admin, GitHub
# Actions quota, and bugs attributed to a third-party binary itself.
_HUMAN_ONLY_RE = re.compile(
    r"\b("
    r"second machine|your mac|ssh yourself|"
    r"mfa|2fa|passkey|post-mfa|"
    r"billing|org-admin|org admin|"
    r"github actions? quota|"
    r"plug in|physical|firmware|keyboard|voyager|kontroll|"
    r"security-info|enroll|portal"
    r")\b",
    re.IGNORECASE,
)
# Optional repository short codes supplied by the consumer. Keep the portable
# default empty rather than embedding a private project registry.
_CROSS_REPO_CODES = [
    code.strip()
    for code in os.environ.get("OPEN_WORK_PROJECT_CODES", "").split(",")
    if code.strip()
]
_CROSS_REPO_RE = (
    re.compile(r"\b(" + "|".join(re.escape(code) for code in _CROSS_REPO_CODES) + r")\b", re.IGNORECASE)
    if _CROSS_REPO_CODES
    else None
)
# "Bare fragment, no clear scope noun" proxy: no backtick-quoted code span,
# no slash path, no colon-scoped prefix, and short. Not precise — that's why
# ambiguous items get a live bd show rather than a final classification here.
_HAS_SCOPE_MARKER_RE = re.compile(r"`[^`]+`|/[\w.-]+/|^\[[\w-]+\]|:\s")
_WHITESPACE_RE = re.compile(r"\s+")


def _one_line(text, limit=110):
    """Every `bucket_reason` lands in a one-line markdown bullet
    (references/rendering.md § Exact compact shape). Free-text sources —
    a multi-paragraph HITL disposition comment — would otherwise inject raw
    newlines that split one bead across several bullets. Bounded like titles."""
    return _WHITESPACE_RE.sub(" ", text).strip()[:limit]


def _looks_ambiguous(title):
    if _HAS_SCOPE_MARKER_RE.search(title):
        return False
    return len(title.split()) < 6


def _hitl_standing_state(item, verb):
    """Most recent `HITL <verb>: <text>` comment for the standing-state
    render string, e.g. "parked 07-20: awaiting hardware". Comment bodies
    come straight from the JSONL export's own `comments` array (bd export
    includes full comment text by default when comment_count > 0 — no live
    `bd comments` call, staying inside the <200ms preprocessor budget).
    Returns a graceful-degrade string (never None) if the label is present
    but no matching comment is found — the label write and the comment write
    are two separate `bd` calls in commands/open.md's disposition batch, so
    a crash between them is a real, if rare, possibility."""
    for c in reversed(item.get("comments") or []):
        m = _HITL_COMMENT_RE.match(c.get("text") or "")
        if m and m.group(1) == verb:
            date = (c.get("created_at") or "")[5:10]  # YYYY-MM-DD... -> MM-DD
            body = m.group(2)
            return _one_line(f"{verb} {date}: {body}" if date else f"{verb}: {body}")
    return f"{verb} (no disposition comment found)"


def _classify_bucket(item, blocked_by):
    iid = item.get("id")
    title = item.get("title") or ""
    labels = item.get("labels") or []
    if iid in blocked_by:
        reason = "blocked by " + ", ".join(blocked_by[iid])
        return "blocked", reason, False, None, False
    if item.get("status") == "in_progress":
        return "in_progress", "status=in_progress", False, None, False
    cross_repo = None
    m = _CROSS_REPO_RE.search(title) if _CROSS_REPO_RE else None
    if m:
        cross_repo = m.group(1).lower()
    for label, verb, target_bucket in HITL_LABELS:
        if label in labels:
            return target_bucket, _hitl_standing_state(item, verb), False, cross_repo, True
    if HUMAN_ONLY_LABEL in labels:
        return "human_only", f"label:{HUMAN_ONLY_LABEL}", False, cross_repo, False
    if title.strip().startswith("[user]"):
        return "human_only", "[user] title prefix", False, cross_repo, False
    if _HUMAN_ONLY_RE.search(title):
        return "human_only", "keyword heuristic", False, cross_repo, False
    return "open", "default", _looks_ambiguous(title), cross_repo, False


def sh(args, cwd, timeout=20):
    try:
        p = subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout
    except Exception:
        return 1, ""


def scan_beads(root, item_cap=ITEM_CAP):
    # Beads tooling was removed from the fleet (2026-09); this source is kept
    # as a stable "unavailable" shape so the inventory contract and its
    # consumers degrade gracefully instead of changing schema.
    return {"available": False, "source": "none"}


def resolve_companion(name):
    explicit_root = os.environ.get("OPEN_WORK_ROOT")
    candidates = []
    if explicit_root:
        candidates.append(os.path.join(explicit_root, "bin", name))
    candidates.append(os.path.join(os.path.dirname(os.path.abspath(__file__)), name))
    path_candidate = shutil.which(name)
    if path_candidate:
        candidates.append(path_candidate)
    return next((path for path in candidates if os.path.isfile(path)), None)


def scan_proposals(root):
    if not os.path.isdir(os.path.join(root, "openspec", "changes")):
        return {"available": False}
    status_bin = resolve_companion("openspec-status")
    if not status_bin:
        return {"available": False, "error": "openspec-status is unavailable"}
    # openspec-status holds a single-instance lock and the statusline's
    # roadmap-pulse refresh invokes it too — retry through transient collisions.
    props = None
    for attempt in range(4):
        rc, out = sh(["bash", status_bin, "--json", "--no-enrich"], root)
        if rc == 0 and out.strip():
            try:
                props = json.loads(out)
                break
            except ValueError:
                pass  # lock-skip sentinel or partial output — retry
        if attempt < 3:
            time.sleep(0.5)  # no wait after the final attempt
    if props is None:
        return {"available": True, "error": "openspec-status failed (lock contention?)"}
    specs = props.get("specs", []) if isinstance(props, dict) else props
    by_state = {}
    for p in specs:
        by_state[p.get("state", "?")] = by_state.get(p.get("state", "?"), 0) + 1
    return {
        "available": True,
        "total_unarchived": len(specs),
        "by_state": by_state,
        "items": [
            {
                "name": p.get("name"),
                "state": p.get("state"),
                "tasks": f"{p.get('tasks_done', 0)}/{p.get('tasks_total', 0)}",
                "epic": p.get("epic_id"),
            }
            for p in specs
        ],
    }


CLOSED_STATUS = re.compile(r"\s*(DONE|REJECTED|SUPERSEDED|ARCHIVED)\b", re.I)
PLAN_ROW = re.compile(r"^\|\s*(\d{3})\s*\|")
PLAN_HEADER = re.compile(r"^\|.*\b(plan|#)\b.*\|.*\bstatus\b.*\|", re.I)
# Markdown table cells escape a literal pipe as `\|` (e.g. a backtick-quoted
# `||` bash operator in prose). A naive split("|") shreds that cell instead of
# treating it as one field — the tail fragment then never starts with DONE/
# REJECTED/etc, so CLOSED_STATUS silently fails to match and a closed row
# reports as open (see plan 012 misclassification, 2026-07-05).
CELL_SPLIT = re.compile(r"(?<!\\)\|")


def _split_row(line):
    cells = [c.strip().replace("\\|", "|") for c in CELL_SPLIT.split(line.strip())]
    if cells and cells[0] == "":
        cells = cells[1:]
    if cells and cells[-1] == "":
        cells = cells[:-1]
    return cells


def scan_plan_dir(root, dirname):
    readme = os.path.join(root, dirname, "README.md")
    if not os.path.isfile(readme):
        # No tracking index -> no triage signal (for example, a harness's plans/
        # directory may be a gitignored plan-mode autosave surface, not project
        # output). Skip rather than report a zero-signal file count.
        return None
    open_rows, done = [], 0
    in_status_table = False
    status_idx = -1  # fallback: last column in a conventional plans/README.md table
    for line in open(readme, encoding="utf-8", errors="replace"):
        # Only rows of a table whose header carries Plan/# AND Status columns —
        # plan READMEs hold other numeric-first tables (findings, waves).
        if not line.lstrip().startswith("|"):
            in_status_table = False
            continue
        if PLAN_HEADER.match(line.strip()):
            in_status_table = True
            # Resolve the Status column by header name, not position — some
            # tables (installfest's plans/README.md) put Status mid-row with
            # Depends-on/Beads columns after it, so cols[-1] silently grabbed
            # a bead ID instead of DONE/REJECTED/etc and every row reported
            # as open regardless of true status (found 2026-07-13 executing
            # /open against installfest: all 7 plans were DONE + beads
            # closed, but /open listed them all as open plan rows).
            header_cells = [c.lower() for c in _split_row(line)]
            status_idx = header_cells.index("status") if "status" in header_cells else -1
            continue
        if not in_status_table:
            continue
        m = PLAN_ROW.match(line.strip())
        if not m:
            continue
        cols = _split_row(line)
        status = cols[status_idx] if cols and -len(cols) <= status_idx < len(cols) else ""
        if CLOSED_STATUS.match(status):
            done += 1
        else:
            open_rows.append({
                "num": m.group(1),
                "title": (cols[1] if len(cols) > 1 else "")[:90],
                "status": status[:110],
            })
    return {"dir": dirname, "open_count": len(open_rows), "closed_count": done, "open": open_rows}


def scan_plans(root):
    dirs = [d for d in (scan_plan_dir(root, "plans"), scan_plan_dir(root, "advisor-plans")) if d]
    if not dirs:
        return {"available": False}
    return {"available": True, "dirs": dirs}


PLAN_SCRATCH_EXTS = (".md", ".html")


def scan_plans_scratch(root):
    # plans/ has no README/ledger by design (codify-plans-ledger-canon Non-Goals — "rot-
    # guaranteed on an auto-dump dir"), so every top-level file counts as unindexed. No
    # `plans/` dir at all is not an error — same shape as scan_plan_dir's own skip.
    plans_dir = os.path.join(root, "plans")
    if not os.path.isdir(plans_dir):
        return {"unindexed": 0, "oldest_days": 0}
    files = [
        name for name in os.listdir(plans_dir)
        if name.lower().endswith(PLAN_SCRATCH_EXTS)
        and os.path.isfile(os.path.join(plans_dir, name))
    ]
    if not files:
        return {"unindexed": 0, "oldest_days": 0}
    now = time.time()
    oldest_days = max(
        int((now - os.path.getmtime(os.path.join(plans_dir, name))) / 86400)
        for name in files
    )
    return {"unindexed": len(files), "oldest_days": oldest_days}


PLAN_PROMOTED_RE = re.compile(r"^promoted:\s*(.+)$", re.MULTILINE)
PLAN_BEAD_RE = re.compile(r"^bead:\s*(.+)$", re.MULTILINE)


def _read_frontmatter(path):
    if not path or not os.path.isfile(path):
        return None
    with open(path, encoding="utf-8", errors="replace") as f:
        text = f.read()
    if not text.startswith("---"):
        return None
    end = text.find("\n---", 3)
    if end == -1:
        return None
    return text[3:end]


def scan_docs_plan(root):
    # docs/plan/ visibility (plan-ledger-closure-and-provenance): a promoted
    # plan otherwise has no signal anywhere that it closed. Non-archived only
    # -- archive/ already means closed, same posture as scan_plans_scratch.
    plan_dir = os.path.join(root, "docs", "plan")
    if not os.path.isdir(plan_dir):
        return {"available": False}
    items = []
    for entry in sorted(os.listdir(plan_dir)):
        if entry == "archive" or entry.startswith("."):
            continue
        full = os.path.join(plan_dir, entry)
        if os.path.isdir(full):
            # Primary file mirrors /feature Phase 4.5's write-back target:
            # scope-lock.md when present, else the dir's first top-level .md.
            primary = os.path.join(full, "scope-lock.md")
            if not os.path.isfile(primary):
                mds = sorted(
                    f for f in os.listdir(full)
                    if f.lower().endswith(".md") and os.path.isfile(os.path.join(full, f))
                )
                primary = os.path.join(full, mds[0]) if mds else None
            name = entry
        elif entry.lower().endswith(".md"):
            primary = full
            name = entry
        else:
            continue
        fm = _read_frontmatter(primary)
        promoted, bead = False, None
        if fm:
            if PLAN_PROMOTED_RE.search(fm):
                promoted = True
            m = PLAN_BEAD_RE.search(fm)
            if m:
                bead = m.group(1).strip().strip('"').strip("'")
        items.append({"name": name, "promoted": promoted, "bead": bead})
    return {"available": True, "items": items}


def _parse_args(argv):
    """-> (item_cap, unknown_args). item_cap 0 means "no cap"."""
    item_cap, unknown_args = ITEM_CAP, []
    for arg in argv:
        if arg == "--json":
            continue
        elif arg.startswith("--limit=") and arg.split("=", 1)[1].isdigit():
            item_cap = int(arg.split("=", 1)[1])
        else:
            unknown_args.append(arg)
    return item_cap, unknown_args


def _guarded(scan, fallback):
    """Per-source isolation, matching this module's "each source degrades
    independently" contract. Without it a single unreadable file (a chmod-000
    plans/README.md, a docs/plan entry mid-rename) escapes to main's catch-all
    and replaces the ENTIRE inventory with {"error": ...} — every other source
    is lost to a fault it had nothing to do with."""
    try:
        return scan()
    except Exception as e:
        return dict(fallback, error=str(e))


def main():
    item_cap, unknown_args = _parse_args(sys.argv[1:])
    if unknown_args:
        print(json.dumps({"error": "unsupported arguments", "arguments": unknown_args}))
        return
    rc, out = sh(["git", "rev-parse", "--show-toplevel"], os.getcwd())
    if rc != 0 or not out.strip():
        print(json.dumps({"error": "not a git repository", "cwd": os.getcwd()}))
        return
    root = out.strip()
    _, head = sh(["git", "rev-parse", "--short", "HEAD"], root)
    result = {
        "project": os.path.basename(root),
        "root": root,
        "head": head.strip(),
        "beads": _guarded(
            lambda: scan_beads(root, item_cap=item_cap),
            {"available": False, "source": "none"},
        ),
        "proposals": _guarded(lambda: scan_proposals(root), {"available": False}),
        "plans": _guarded(lambda: scan_plans(root), {"available": False}),
        "plans_scratch": _guarded(lambda: scan_plans_scratch(root), {"unindexed": 0, "oldest_days": 0}),
        "docs_plan": _guarded(lambda: scan_docs_plan(root), {"available": False}),
    }
    b, p, pl = result["beads"], result["proposals"], result["plans"]
    result["summary"] = {
        "open_beads": b.get("total_open", 0),
        "unarchived_proposals": p.get("total_unarchived", 0),
        "open_plans": sum(d.get("open_count", 0) for d in pl.get("dirs", [])),
    }
    print(json.dumps(result))


if __name__ == "__main__":
    try:
        main()
    except Exception as e:  # contract: never non-zero, never stderr
        print(json.dumps({"error": str(e)}))
    sys.exit(0)
